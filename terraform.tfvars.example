# Copy this file to terraform.tfvars and fill in your values.
# (terraform.tfvars is gitignored — keep real values out of version control.)
#
# NOTE: provider_api_key and telegram_bot_token are sensitive. They are injected
# into the VM via user_data, which is stored in Terraform state. Prefer supplying
# them via environment variables (TF_VAR_provider_api_key, TF_VAR_telegram_bot_token)
# rather than committing them anywhere.

# --- REQUIRED ----------------------------------------------------------------

# Pick a provider — the default model and base URL are auto-filled from the
# provider catalogue in providers.tf:
#   openrouter  → anthropic/claude-sonnet-4  + https://openrouter.ai/api/v1
#   anthropic   → claude-sonnet-4            + https://api.anthropic.com
#   openai      → gpt-4.1                    + https://api.openai.com/v1
#   nvidia      → z-ai/glm-5.1              + https://integrate.api.nvidia.com/v1
model_provider = "openrouter"

# API key for the chosen model_provider.
provider_api_key = "sk-..."

# Telegram bot token (from @BotFather). One running gateway per token.
telegram_bot_token = "123456789:ABCdEf..."

# MANDATORY: comma-separated NUMERIC Telegram user IDs allowed to use the bot.
# Without this the gateway denies everyone ("online but silent").
telegram_allowed_users = "123456789,987654321"

# --- Optional overrides (defaults shown) -------------------------------------

# Override the default model for the chosen provider (empty = catalogue default).
# model_name = ""

# Override the provider API base URL (empty = catalogue default).
# provider_base_url = ""

# Optional: GitHub PAT — enables gh CLI + git push on the deployed VM.
# Leave unset (or empty) to skip GitHub auth entirely.
# github_token = "ghp_..."

# --- Infra overrides (defaults shown) ----------------------------------------
# region = "us-east-1"
# instance_type = "t3.medium"
# availability_zone = "us-east-1d"  # empty = first subnet in the default VPC
# name = "hermes"
# root_volume_size = 20

# Inbound TCP ports open on the instance for web prototyping.
# Set to [] to revert to egress-only (no inbound access).
# allowed_ports = [3000, 4000, 5000, 5173, 8000, 8080, 8443, 8888]

# tags = {
#   Project = "hermes"
# }
